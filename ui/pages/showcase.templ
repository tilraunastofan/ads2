package pages

import (
	"strconv"

	"github.com/tilraunastofan/ads2/components/alert"
	"github.com/tilraunastofan/ads2/components/alertdialog"
	"github.com/tilraunastofan/ads2/components/button"
	"github.com/tilraunastofan/ads2/components/card"
	"github.com/tilraunastofan/ads2/components/dialog"
	"github.com/tilraunastofan/ads2/components/dropdownmenu"
	"github.com/tilraunastofan/ads2/components/empty"
	"github.com/tilraunastofan/ads2/components/field"
	"github.com/tilraunastofan/ads2/components/icon"
	"github.com/tilraunastofan/ads2/components/input"
	"github.com/tilraunastofan/ads2/components/inputgroup"
	"github.com/tilraunastofan/ads2/components/nativeselect"
	"github.com/tilraunastofan/ads2/components/progress"
	"github.com/tilraunastofan/ads2/components/sheet"
	switchcomp "github.com/tilraunastofan/ads2/components/switch"
	"github.com/tilraunastofan/ads2/components/table"
	"github.com/tilraunastofan/ads2/components/tabs"
	"github.com/tilraunastofan/ads2/components/toast"
	"github.com/tilraunastofan/ads2/patterns"
	"github.com/tilraunastofan/ads2/ui/layouts"
)

// ---- view models -------------------------------------------------------------

type App struct {
	Name    string
	Env     string
	Version string
	Health  string // Healthy, Progressing, Degraded
}

type ShowcaseVM struct {
	KPIs  []patterns.StatProps
	Apps  []App
	Query string
}

// ---- page --------------------------------------------------------------------

templ Showcase(vm ShowcaseVM) {
	@layouts.App("Applications", "/apps") {
		@patterns.PageHeader(patterns.PageHeaderProps{
			Crumbs: []patterns.Crumb{{Label: "Platform", Href: "/"}, {Label: "Applications"}},
			Title:  "Applications",
			Status: "Cluster ocp-prod-1, synced 1 minute ago.",
		}) {
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Href:    "/apps.csv",
				// download: the browser saves the file, and htmx's boost leaves the link alone.
				Attributes: templ.Attributes{"download": "applications.csv"},
			}) {
				@icon.Download()
				Export
			}
			@NewAppSheet()
		}
		@patterns.StatRow() {
			for _, k := range vm.KPIs {
				@patterns.Stat(k)
			}
		}
		@tabs.Tabs(tabs.Props{DefaultValue: "health"}) {
			@tabs.List(tabs.ListProps{Variant: tabs.VariantLine}) {
				@tabs.Trigger(tabs.TriggerProps{Value: "health"}) {
					Health
				}
				@tabs.Trigger(tabs.TriggerProps{Value: "rollout"}) {
					Rollout
				}
			}
			@tabs.Content(tabs.ContentProps{Value: "health"}) {
				@AppsCard(vm)
			}
			@tabs.Content(tabs.ContentProps{Value: "rollout"}) {
				@RolloutCard(2, 3, "intersect once")
			}
		}
	}
}

// ---- applications table (live search + row actions) ---------------------------

templ AppsCard(vm ShowcaseVM) {
	@patterns.DataCard(patterns.DataCardProps{
		Title:       "Sync and health",
		Description: "Argo CD in ocp-prod-1",
		Action:      AppSearch(vm.Query),
	}) {
		@table.Table() {
			@table.Header() {
				@table.Row() {
					@table.Head() {
						Application
					}
					@table.Head() {
						Environment
					}
					@table.Head() {
						Version
					}
					@table.Head() {
						Health
					}
					@table.Head() {
						<span class="sr-only">Actions</span>
					}
				}
			}
			@AppRows(vm.Apps)
		}
	}
}

templ AppSearch(q string) {
	@inputgroup.InputGroup(inputgroup.Props{Class: "w-64"}) {
		@inputgroup.Input(inputgroup.InputProps{
			ID:          "app-search",
			Type:        "search",
			Name:        "q",
			Value:       q,
			Placeholder: "Search applications",
			Attributes: templ.Attributes{
				"hx-get":     "/apps/rows",
				"hx-trigger": "input changed delay:300ms, search",
				"hx-target":  "#app-rows",
				"hx-swap":    "outerHTML",
				"aria-label": "Search applications",
			},
		})
		@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineStart}) {
			@icon.Search()
		}
	}
}

// AppRows is the htmx swap target for search results.
templ AppRows(apps []App) {
	@table.Body(table.BodyProps{ID: "app-rows"}) {
		if len(apps) == 0 {
			@table.Row() {
				@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "5"}}) {
					@empty.Empty() {
						@empty.Header() {
							@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
								@icon.Inbox()
							}
							@empty.Title() {
								No matching applications
							}
							@empty.Description() {
								Try another name or clear the search.
							}
						}
					}
				}
			}
		}
		for _, a := range apps {
			@AppRow(a)
		}
	}
}

templ AppRow(a App) {
	@table.Row(table.RowProps{ID: "app-" + a.Name}) {
		@table.Cell(table.CellProps{Class: "font-medium"}) {
			{ a.Name }
		}
		@table.Cell() {
			{ a.Env }
		}
		@table.Cell(table.CellProps{Class: "font-mono text-code"}) {
			{ a.Version }
		}
		@table.Cell() {
			@HealthBadge(a.Health)
		}
		@table.Cell(table.CellProps{Class: "pr-2 text-right"}) {
			@RowActions(a)
		}
	}
}

templ HealthBadge(h string) {
	switch h {
		case "Healthy":
			@patterns.StatusBadge(patterns.StatusPositive, h)
		case "Progressing":
			@patterns.StatusBadge(patterns.StatusWarning, h)
		case "Degraded":
			@patterns.StatusBadge(patterns.StatusDestructive, h)
		default:
			@patterns.StatusBadge(patterns.StatusNeutral, h)
	}
}

templ RowActions(a App) {
	@dropdownmenu.DropdownMenu() {
		@button.Button(button.Props{
			Variant:    button.VariantGhost,
			Size:       button.SizeIconSm,
			Attributes: mergeAttrs(dropdownmenu.Trigger(ctx), templ.Attributes{"aria-label": "Actions for " + a.Name}),
		}) {
			@icon.Ellipsis()
		}
		@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd}) {
			@dropdownmenu.Label() {
				{ a.Name }
			}
			@dropdownmenu.Item(dropdownmenu.ItemProps{Attributes: templ.Attributes{"hx-post": "/apps/" + a.Name + "/restart", "hx-swap": "none"}}) {
				@icon.RotateCcw()
				Restart pods
			}
			@dropdownmenu.Item(dropdownmenu.ItemProps{Attributes: templ.Attributes{"hx-post": "/apps/" + a.Name + "/sync", "hx-swap": "none"}}) {
				@icon.GitBranch()
				Sync now
			}
			@dropdownmenu.Item(dropdownmenu.ItemProps{Attributes: opens(scaleID(a))}) {
				@icon.Scaling()
				Scale…
			}
			@dropdownmenu.Separator()
			@dropdownmenu.Item(dropdownmenu.ItemProps{Variant: dropdownmenu.ItemVariantDestructive, Attributes: opens(deleteID(a))}) {
				@icon.Trash2()
				Delete…
			}
		}
	}
	@ScaleDialog(a)
	@DeleteApp(a)
}

func scaleID(a App) string  { return "scale-" + a.Name }
func deleteID(a App) string { return "delete-" + a.Name }

// opens makes a menu item open the dialog or alert dialog with that ID (the
// dialogs' TriggerFor, minus the attributes that would override the item's own
// slot, role and focus handling).
func opens(id string) templ.Attributes {
	return templ.Attributes{"data-base-ui-click-trigger": true, "data-templ-controls": id, "aria-haspopup": "dialog"}
}

// DeleteApp is the confirmation the row menu's Delete… opens.
templ DeleteApp(a App) {
	@alertdialog.AlertDialog(alertdialog.Props{ID: deleteID(a)}) {
		@alertdialog.Content() {
			@alertdialog.Header() {
				@alertdialog.Title() {
					Delete application “{ a.Name }”?
				}
				@alertdialog.Description() {
					Argo CD removes all its resources from { a.Env }. This cannot be undone.
				}
			}
			@alertdialog.Footer() {
				@alertdialog.Cancel() {
					Cancel
				}
				@alertdialog.Action(alertdialog.ActionProps{
					Variant: button.VariantDestructive,
					Attributes: templ.Attributes{
						"hx-delete":  "/apps/" + a.Name,
						"hx-include": "#app-search",
						"hx-target":  "#app-rows",
						"hx-swap":    "outerHTML",
					},
				}) {
					Delete application
				}
			}
		}
	}
}

func mergeAttrs(a, b templ.Attributes) templ.Attributes {
	out := templ.Attributes{}
	for k, v := range a {
		out[k] = v
	}
	for k, v := range b {
		out[k] = v
	}
	return out
}

// ---- form with server validation ----------------------------------------------

type NewAppErrors struct {
	Name     string
	Replicas string
	Values   map[string]string
}

func (e NewAppErrors) val(k string) string {
	if e.Values == nil {
		return ""
	}
	return e.Values[k]
}

// replicas is the submitted value, or 3 on a fresh form.
func (e NewAppErrors) replicas() string {
	if e.Values == nil {
		return "3"
	}
	return e.Values["replicas"]
}

func invalid(msg string) templ.Attributes {
	if msg == "" {
		return templ.Attributes{}
	}
	return templ.Attributes{"data-invalid": "true"}
}

const newAppSheetID = "new-app"

// NewAppSheet is the page's primary action: a sheet holding the create form.
templ NewAppSheet() {
	@sheet.Sheet(sheet.Props{ID: newAppSheetID}) {
		@button.Button(button.Props{Attributes: sheet.Trigger(ctx)}) {
			@icon.Plus()
			New application
		}
		@sheet.Content() {
			@sheet.Header() {
				@sheet.Title() {
					New application
				}
				@sheet.Description() {
					Creates a Helm release and an Argo CD application.
				}
			}
			@NewAppForm(NewAppErrors{})
		}
	}
}

// NewAppForm posts itself and is re-rendered by the server: with field errors on
// 422 (the sheet stays open), empty on success, when the response also refreshes
// the table and raises a toast and dialog-form.js closes the sheet.
templ NewAppForm(e NewAppErrors) {
	<form id="new-app-form" hx-post="/apps" hx-target="this" hx-swap="outerHTML" hx-status:422="target:this" data-close-on-success class="flex flex-1 flex-col">
		<div class="flex-1 px-4">
			@field.Group() {
				@field.Field(field.Props{Attributes: invalid(e.Name)}) {
					@field.Label(field.LabelProps{For: "name"}) {
						Application name
					}
					@input.Input(input.Props{ID: "name", Name: "name", Value: e.val("name"), Attributes: templ.Attributes{"aria-invalid": e.Name != "", "autocomplete": "off"}})
					if e.Name != "" {
						@field.Error() {
							{ e.Name }
						}
					} else {
						@field.Description() {
							Lowercase letters, digits and dashes.
						}
					}
				}
				@field.Field() {
					@field.Label(field.LabelProps{For: "namespace"}) {
						Namespace
					}
					@nativeselect.NativeSelect(nativeselect.Props{ID: "namespace", Name: "namespace"}) {
						@nativeselect.Option(nativeselect.OptionProps{Value: "payments"}) {
							payments
						}
						@nativeselect.Option(nativeselect.OptionProps{Value: "lending"}) {
							lending
						}
						@nativeselect.Option(nativeselect.OptionProps{Value: "platform"}) {
							platform
						}
					}
				}
				@field.Field(field.Props{Attributes: invalid(e.Replicas)}) {
					@field.Label(field.LabelProps{For: "replicas"}) {
						Replicas
					}
					@input.Input(input.Props{ID: "replicas", Name: "replicas", Type: "number", Value: e.replicas(), Attributes: templ.Attributes{"aria-invalid": e.Replicas != ""}})
					if e.Replicas != "" {
						@field.Error() {
							{ e.Replicas }
						}
					} else {
						@field.Description() {
							At least 2 in production.
						}
					}
				}
				@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
					@switchcomp.Switch(switchcomp.Props{ID: "autosync", Name: "autosync", DefaultChecked: true})
					@field.Label(field.LabelProps{For: "autosync"}) {
						Auto-sync with Argo CD
					}
				}
			}
		</div>
		@sheet.Footer() {
			@button.Button(button.Props{Type: button.TypeSubmit, Attributes: templ.Attributes{"hx-disable": "this"}}) {
				Create application
			}
			@button.Button(button.Props{Variant: button.VariantOutline, Attributes: sheet.CloseFor(newAppSheetID)}) {
				Cancel
			}
		}
	</form>
}

// ---- polling progress -----------------------------------------------------------

// RolloutCard polls itself until ready == desired. The first render passes
// "intersect once" so polling starts when its (initially hidden) tab opens;
// "every 2s" alone would start at page load. Responses pass "every 2s".
templ RolloutCard(ready, desired int, trigger string) {
	<div
		id="rollout"
		if ready < desired {
			hx-get="/rollout"
			hx-trigger={ trigger }
			hx-swap="outerHTML"
		}
		class="max-w-xl"
	>
		@card.Card() {
			@card.Header() {
				@card.Title() {
					payments-api 1.42.0
				}
				@card.Description() {
					Rolling update in production
				}
			}
			@card.Content() {
				@progress.Progress(progress.Props{Value: ready, Max: desired}) {
					@progress.Label() {
						Pods ready
					}
					// An element child: progress.js only rewrites a bare-text value to "67%".
					@progress.Value() {
						<span>{ strconv.Itoa(ready) } of { strconv.Itoa(desired) }</span>
					}
				}
				if ready >= desired {
					@alert.Alert(alert.Props{Class: "mt-4"}) {
						@icon.CircleCheck()
						@alert.Title() {
							Rollout complete
						}
						@alert.Description() {
							All pods are ready.
						}
					}
				}
			}
		}
	</div>
}

// ---- dialog -------------------------------------------------------------------

// ScaleDialog scales one application; the row menu's Scale… opens it.
templ ScaleDialog(a App) {
	@dialog.Dialog(dialog.Props{ID: scaleID(a)}) {
		@dialog.Content() {
			<form hx-post="/scale" hx-swap="none" data-close-on-success class="grid gap-4">
				<input type="hidden" name="app" value={ a.Name }/>
				@dialog.Header() {
					@dialog.Title() {
						Scale { a.Name }
					}
					@dialog.Description() {
						Opens a pull request that sets the replica count. Argo CD syncs within a minute of the merge.
					}
				}
				@field.Field() {
					@field.Label(field.LabelProps{For: scaleID(a) + "-replicas"}) {
						Replicas
					}
					@input.Input(input.Props{ID: scaleID(a) + "-replicas", Name: "replicas", Type: "number", Value: "3"})
				}
				@dialog.Footer() {
					@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) {
						Cancel
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Attributes: templ.Attributes{"hx-disable": "this"}}) {
						Open pull request
					}
				}
			</form>
		}
	}
}

// Toast is returned (out of band) by action handlers.
templ Toast(title, description string, t toast.Type) {
	@toast.Toast(toast.Props{Title: title, Description: description, Type: t})
}

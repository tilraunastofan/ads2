package layouts

import (
	"github.com/tilraunastofan/ads2/components"
	"github.com/tilraunastofan/ads2/components/icon"
	"github.com/tilraunastofan/ads2/components/sidebar"
	"github.com/tilraunastofan/ads2/components/toast"
)

type NavItem struct {
	Label string
	Href  string
	Icon  templ.Component
}

func Nav() []NavItem {
	return []NavItem{
		{Label: "Overview", Href: "/", Icon: icon.House()},
		{Label: "Applications", Href: "/apps", Icon: icon.GitBranch()},
		{Label: "Metrics", Href: "/metrics", Icon: icon.ChartColumn()},
		{Label: "Settings", Href: "/settings", Icon: icon.Settings2()},
	}
}

// Base is the HTML document: theme CSS, vendored htmx 4, the shadcn-templ
// component bundle and the toaster. Pages render inside it.
templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Arion Design System 2</title>
			<link rel="icon" type="image/svg+xml" href="/assets/img/arion-mark.svg"/>
			<link rel="stylesheet" href="/assets/css/fonts.css"/>
			<link rel="stylesheet" href="/assets/css/output.css"/>
			<script src="/assets/js/htmx.min.js" defer></script>
			@components.Scripts()
		</head>
		<body class="style-nova min-h-svh">
			{ children... }
			<div id="toasts" hidden></div>
			@toast.Toaster()
		</body>
	</html>
}

// App is the internal-tool shell: sidebar navigation plus an inset that holds
// the page. currentPath marks the active menu item.
templ App(title, currentPath string) {
	@Base(title) {
		@sidebar.Provider() {
			@sidebar.Sidebar(sidebar.Props{Collapsible: sidebar.CollapsibleIcon}) {
				@sidebar.Header() {
					<a href="/" class="flex items-center gap-2 p-2">
						<img src="/assets/img/arion-mark.svg" alt="Arion" width="32" height="32" class="size-8"/>
						<span class="grid text-left text-sm leading-tight group-data-[collapsible=icon]:hidden">
							<span class="truncate font-medium">Platform</span>
							<span class="truncate text-xs text-muted-foreground">on-prem · OpenShift</span>
						</span>
					</a>
				}
				@sidebar.Content() {
					@sidebar.Group() {
						@sidebar.GroupLabel() {
							Workloads
						}
						@sidebar.Menu() {
							for _, it := range Nav() {
								@sidebar.MenuItem() {
									@sidebar.MenuButton(sidebar.MenuButtonProps{Href: it.Href, IsActive: it.Href == currentPath, Tooltip: it.Label}) {
										@it.Icon
										<span>{ it.Label }</span>
									}
								}
							}
						}
					}
				}
			}
			@sidebar.Inset() {
				<header class="flex h-14 items-center gap-2 border-b px-4">
					@sidebar.Trigger()
				</header>
				<main id="main" class="mx-auto flex w-full max-w-[1200px] flex-col gap-6 p-6">
					{ children... }
				</main>
			}
		}
	}
}

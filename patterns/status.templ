package patterns

import (
	"github.com/tilraunastofan/ads2/components/badge"
	"github.com/tilraunastofan/ads2/components/icon"
)

// Status is the meaning of a state, independent of the words an app uses for it.
type Status string

const (
	StatusPositive    Status = "positive"    // healthy, succeeded, synced
	StatusWarning     Status = "warning"     // progressing, needs attention
	StatusDestructive Status = "destructive" // failed, degraded, down, out of sync
	StatusNeutral     Status = "neutral"     // unknown, pending, archived
)

func (s Status) classes() string {
	switch s {
	case StatusPositive:
		return "bg-positive/10 text-positive dark:bg-positive/20"
	case StatusWarning:
		return "bg-warning/10 text-warning dark:bg-warning/20"
	}
	return ""
}

func (s Status) variant() badge.Variant {
	switch s {
	case StatusDestructive:
		return badge.VariantDestructive
	case StatusNeutral:
		return badge.VariantOutline
	}
	return badge.VariantSecondary
}

// StatusBadge is a state as a pill. Colour never carries the state alone: every
// status has an icon and the label is always shown.
templ StatusBadge(s Status, label string) {
	@badge.Badge(badge.Props{Variant: s.variant(), Class: s.classes()}) {
		switch s {
			case StatusPositive:
				@icon.CircleCheck()
			case StatusWarning:
				@icon.TriangleAlert()
			case StatusDestructive:
				@icon.CircleAlert()
			default:
				@icon.CircleDashed()
		}
		{ label }
	}
}

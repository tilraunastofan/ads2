package patterns

import (
	"github.com/tilraunastofan/ads2/components/card"
)

type DataCardProps struct {
	ID          string
	Title       string
	Description string
	Action      templ.Component // optional: search box, button or menu in the header
}

// DataCard is a card whose content is a table running edge to edge. Its first
// and last columns get the card's 16px inset, so tables need no pl-4/pr-4.
templ DataCard(p DataCardProps) {
	@card.Card(card.Props{ID: p.ID, Class: "gap-0 pb-0 [&_tr>:first-child]:pl-4 [&_tr>:last-child]:pr-4"}) {
		@card.Header(card.HeaderProps{Class: "border-b"}) {
			@card.Title() {
				{ p.Title }
			}
			if p.Description != "" {
				@card.Description() {
					{ p.Description }
				}
			}
			if p.Action != nil {
				@card.Action() {
					@p.Action
				}
			}
		}
		{ children... }
	}
}

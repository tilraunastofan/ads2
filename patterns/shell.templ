package patterns

import (
	"github.com/tilraunastofan/ads2/components"
	"github.com/tilraunastofan/ads2/components/sidebar"
	"github.com/tilraunastofan/ads2/components/toast"
)

type NavItem struct {
	Label string
	Href  string
	Icon  templ.Component
}

type ShellProps struct {
	Title       string // page title for <title>
	Product     string // sidebar header, first line
	Tagline     string // sidebar header, second line
	GroupLabel  string // sidebar group heading
	Nav         []NavItem
	CurrentPath string // marks the active item
	Lang        string // defaults to "en"
}

// Base is the HTML document: fonts, theme CSS, theme.js (before paint, so no
// flash), vendored htmx 4, the component bundle and the toast mount.
templ Base(title, lang string) {
	<!DOCTYPE html>
	<html lang={ langOr(lang) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" type="image/svg+xml" href="/assets/img/arion-mark.svg"/>
			<link rel="stylesheet" href="/assets/css/fonts.css"/>
			<link rel="stylesheet" href="/assets/css/output.css"/>
			<script src="/assets/js/theme.js"></script>
			<script src="/assets/js/htmx.min.js" defer></script>
			@components.Scripts()
		</head>
		<body class="style-nova min-h-svh" hx-boost:inherited="true">
			{ children... }
			<div id="toasts" hidden></div>
			@toast.Toaster()
		</body>
	</html>
}

func langOr(l string) string {
	if l == "" {
		return "en"
	}
	return l
}

// Shell is the internal-tool layout: sidebar navigation plus an inset holding a
// single column (max 1200px, 24px padding) with the theme toggle in its top bar.
templ Shell(p ShellProps) {
	@Base(p.Title, p.Lang) {
		@sidebar.Provider() {
			@sidebar.Sidebar(sidebar.Props{Collapsible: sidebar.CollapsibleIcon}) {
				@sidebar.Header() {
					<a href="/" class="flex items-center gap-2 p-2">
						<img src="/assets/img/arion-mark.svg" alt="Arion" width="32" height="32" class="size-8"/>
						<span class="grid text-left text-sm leading-tight group-data-[collapsible=icon]:hidden">
							<span class="truncate font-medium">{ p.Product }</span>
							<span class="truncate text-xs text-muted-foreground">{ p.Tagline }</span>
						</span>
					</a>
				}
				@sidebar.Content() {
					@sidebar.Group() {
						@sidebar.GroupLabel() {
							{ p.GroupLabel }
						}
						@sidebar.Menu(sidebar.MenuProps{Class: "gap-1"}) {
							for _, it := range p.Nav {
								@sidebar.MenuItem() {
									@sidebar.MenuButton(sidebar.MenuButtonProps{Href: it.Href, IsActive: it.Href == p.CurrentPath, Tooltip: it.Label}) {
										@it.Icon
										<span>{ it.Label }</span>
									}
								}
							}
						}
					}
				}
			}
			@sidebar.Inset() {
				<header class="flex h-14 items-center justify-between gap-2 border-b px-4">
					@sidebar.Trigger()
					@ThemeToggle()
				</header>
				<main id="main" class="mx-auto flex w-full max-w-[1200px] flex-col gap-6 p-6">
					{ children... }
				</main>
			}
		}
	}
}

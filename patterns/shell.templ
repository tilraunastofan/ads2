package patterns

import (
	"cmp"
	"slices"

	"github.com/tilraunastofan/ads2/components"
	"github.com/tilraunastofan/ads2/components/alert"
	"github.com/tilraunastofan/ads2/components/icon"
	"github.com/tilraunastofan/ads2/components/sidebar"
	"github.com/tilraunastofan/ads2/components/toast"
)

type NavItem struct {
	Label string
	Href  string
	Icon  templ.Component // optional; a collapsed sidebar shows only icons, so give every item one
	// Children are sub-items listed under the item, always expanded (one level; their
	// own Children and Icon are ignored). A collapsed sidebar hides them.
	Children []NavItem
}

// NavGroup is one labelled group of sidebar items.
type NavGroup struct {
	Label string
	Items []NavItem
}

type ShellProps struct {
	Title       string     // page title for <title>
	Product     string     // sidebar header, first line
	Tagline     string     // sidebar header, second line
	Groups      []NavGroup // sidebar groups; when empty, GroupLabel and Nav form one group
	GroupLabel  string     // single-group form: the group heading
	Nav         []NavItem  // single-group form: its items
	CurrentPath string     // marks the active item: the one whose Href is the longest match (the path or a segment prefix of it)
	Lang        string     // defaults to "en"
	Footer      []NavItem  // pinned to the bottom of the sidebar, below the scrolling groups (About, Account)
	FooterNote  string     // small muted line under Footer, such as the version; hidden when the sidebar is collapsed
	Background  Background // optional image behind the content column; for calm pages, not data pages
}

// Background is a decorative image Shell lays behind the page content, below
// the top bar, covering the inset. Light shows in light mode and Dark under
// .dark; set one and it shows in both. The zero value shows nothing. Use it on
// calm, short pages (home, help, about), not on tables people scan.
type Background struct {
	Light string // image URL for light mode
	Dark  string // image URL for dark mode
}

// ArcticBackground is the Arion arctic landscape in ads2's assets
// (assets/img/arctic-background{-light,}.svg): a night sky with aurora, grid and
// mountain lines, and a pale ice-blue version of it for light mode.
var ArcticBackground = Background{
	Light: "/assets/img/arctic-background-light.svg",
	Dark:  "/assets/img/arctic-background.svg",
}

func (b Background) set() bool { return b.Light != "" || b.Dark != "" }

// both reports whether light and dark mode use different images.
func (b Background) both() bool { return b.Light != "" && b.Dark != "" && b.Light != b.Dark }

// navGroups is every group the active item is chosen from: the groups and the footer.
func (p ShellProps) navGroups() []NavGroup {
	return slices.Concat(p.groups(), []NavGroup{{Items: p.Footer}})
}

func (p ShellProps) groups() []NavGroup {
	if len(p.Groups) > 0 {
		return p.Groups
	}
	return []NavGroup{{Label: p.GroupLabel, Items: p.Nav}}
}

// Base is the HTML document: the two fonts every page shows, preloaded so they
// download alongside the CSS instead of after it; the font and theme CSS; theme.js
// (before paint, so no flash); the htmx-config meta (preload on hover for boosted
// links; it must come before htmx); vendored htmx 4 and its extensions hx-preload,
// hx-history-cache and hx-ptag (assets/js/ext/); clear-history.js (form[data-clear-history] empties the history
// cache on submit); toast-guard.js (works around a
// toast freeze on boosted navigation); filter-form.js (form[data-filter-form]
// fires filter-change when its values change); request-errors.js (a toast for
// network failures and unhandled 5xx); dialog-form.js (form[data-close-on-success]
// closes its dialog after a 2xx); datepicker.js (form[data-date-picker] glue);
// focus-after-swap.js (puts focus back where the user can carry on when a swap
// removes it); copy.js ([data-copy-target] copy buttons); submit-once.js
// (form[data-disable-on-submit] disables its submit button while the request runs);
// the component bundle; and the toast mount. Each helper does nothing
// on a page without its markup, so Base loads them all once instead of per page:
// a page's own <script> runs again on every boosted visit.
templ Base(title, lang string) {
	<!DOCTYPE html>
	<html lang={ langOr(lang) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" type="image/svg+xml" href="/assets/img/arion-mark-favicon.svg"/>
			<link rel="preload" href="/assets/fonts/hanken-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/assets/fonts/source-serif-4-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/assets/css/fonts.css"/>
			<link rel="stylesheet" href="/assets/css/output.css"/>
			<script src="/assets/js/theme.js"></script>
			<meta name="htmx-config" content='{"preload":{"autoBoost":true,"boostEvent":"mouseover"}}'/>
			<script src="/assets/js/htmx.min.js" defer></script>
			<script src="/assets/js/ext/hx-preload.js" defer></script>
			<script src="/assets/js/ext/hx-history-cache.js" defer></script>
			<script src="/assets/js/ext/hx-ptag.js" defer></script>
			<script src="/assets/js/clear-history.js" defer></script>
			<script src="/assets/js/toast-guard.js" defer></script>
			<script src="/assets/js/filter-form.js" defer></script>
			<script src="/assets/js/request-errors.js" defer></script>
			<script src="/assets/js/dialog-form.js" defer></script>
			<script src="/assets/js/datepicker.js" defer></script>
			<script src="/assets/js/focus-after-swap.js" defer></script>
			<script src="/assets/js/copy.js" defer></script>
			<script src="/assets/js/submit-once.js" defer></script>
			@components.Scripts()
		</head>
		<body class="style-nova min-h-svh" hx-boost:inherited="true">
			{ children... }
			<div id="toasts" hidden></div>
			@toast.Toaster()
		</body>
	</html>
}

func first(s []string) string {
	if len(s) == 0 {
		return ""
	}
	return s[0]
}

func langOr(l string) string {
	if l == "" {
		return "en"
	}
	return l
}

// backgroundClass places a background image: from below the 3.5rem top bar to
// the bottom of the sidebar inset (which is relative), cropped to cover it, and
// never in the way of clicks.
const backgroundClass = "pointer-events-none absolute inset-x-0 top-14 h-[calc(100%-3.5rem)] w-full object-cover"

// background is the image(s) behind the content: one per theme when both are
// set, following .dark like the tokens do; else the one set, in both themes.
templ background(b Background) {
	if b.both() {
		<img src={ b.Light } alt="" aria-hidden="true" data-shell-background="light" class={ backgroundClass + " dark:hidden" }/>
		<img src={ b.Dark } alt="" aria-hidden="true" data-shell-background="dark" class={ backgroundClass + " hidden dark:block" }/>
	} else {
		<img src={ cmp.Or(b.Light, b.Dark) } alt="" aria-hidden="true" data-shell-background class={ backgroundClass }/>
	}
}

// Shell is the internal-tool layout: sidebar navigation plus an inset holding a
// single column (max 1200px, 24px padding) with the theme toggle in its top bar.
// A skip link, the first thing a keyboard reaches, jumps past the navigation.
templ Shell(p ShellProps) {
	@Base(p.Title, p.Lang) {
		@SkipLink(p.Lang)
		// The collapsed rail is 4rem, not shadcn's 3rem: the 32px mark plus the header's
		// and the link's 8px padding on each side need 64px. The menu icons are centred
		// in it (group-data-[collapsible=icon]:items-center) so they line up under the mark.
		// DisableDefaultOpen: render the state the user left the sidebar in (the
		// SidebarState middleware reads sidebar.js's cookie), or every page load and
		// boosted navigation would expand it again.
		@sidebar.Provider(sidebar.ProviderProps{
			DisableDefaultOpen: sidebarCollapsed(ctx),
			Attributes:         templ.Attributes{"style": "--sidebar-width: 16rem; --sidebar-width-icon: 4rem;"},
		}) {
			@sidebar.Sidebar(sidebar.Props{Collapsible: sidebar.CollapsibleIcon}) {
				@sidebar.Header() {
					<a href="/" class="flex items-center gap-2 p-2">
						@ArionMark("size-8 shrink-0")
						<span class="grid text-left text-body-sm leading-tight group-data-[collapsible=icon]:hidden">
							<span class="truncate font-medium">{ p.Product }</span>
							<span class="truncate text-caption text-muted-foreground">{ p.Tagline }</span>
						</span>
					</a>
				}
				{{ active := activeHref(p.navGroups(), p.CurrentPath) }}
				@sidebar.Content() {
					for _, g := range p.groups() {
						@sidebar.Group() {
							if g.Label != "" {
								@sidebar.GroupLabel() {
									{ g.Label }
								}
							}
							@navMenu(g.Items, active)
						}
					}
				}
				// The footer sits outside the scrolling Content, so it stays at the bottom.
				if len(p.Footer) > 0 || p.FooterNote != "" {
					@sidebar.Footer() {
						if len(p.Footer) > 0 {
							@navMenu(p.Footer, active)
						}
						if p.FooterNote != "" {
							<p class="truncate px-2 text-caption text-muted-foreground group-data-[collapsible=icon]:hidden">{ p.FooterNote }</p>
						}
					}
				}
			}
			// min-w-0: a flex item is never narrower than its content, so without it a
			// wide table or code block widens the whole page instead of scrolling in its card.
			@sidebar.Inset(sidebar.InsetProps{Class: "min-w-0"}) {
				<header class="flex h-14 items-center justify-between gap-2 border-b px-4">
					@sidebar.Trigger(sidebar.TriggerProps{Attributes: templ.Attributes{"aria-label": labelsFor(p.Lang).ToggleSidebar}})
					// The wrapper exists only with header actions, so an app without them
					// gets exactly the markup it always had.
					if a := HeaderActionsFrom(ctx); a != nil {
						<div class="flex items-center gap-2">
							@a
							@ThemeToggle(p.Lang)
						</div>
					} else {
						@ThemeToggle(p.Lang)
					}
				</header>
				if p.Background.set() {
					@background(p.Background)
				}
				// The sidebar inset is the page's one <main>; this is the skip link's target.
				// With a background it is relative, so it paints above the image.
				<div id="main" tabindex="-1" class={ "mx-auto flex w-full max-w-[1200px] flex-col gap-6 p-6 outline-none", templ.KV("relative", p.Background.set()) }>
					// Target for errors that belong on the page rather than in a toast:
					// hx-status:5xx="target:#page-alerts" with an alert.Alert response.
					<div id="page-alerts" role="status" aria-live="polite" class="empty:hidden"></div>
					if b := BannerFrom(ctx); b != nil {
						@banner(*b)
					}
					{ children... }
				</div>
			}
		}
	}
}

// banner is the page-wide notice from WithBanner: destructive for a failure,
// warning otherwise, with an icon so colour doesn't carry the state alone.
templ banner(b Banner) {
	if b.Destructive {
		@alert.Alert(alert.Props{ID: "page-banner", Variant: alert.VariantDestructive}) {
			@icon.CircleAlert()
			@bannerBody(b)
		}
	} else {
		@alert.Alert(alert.Props{ID: "page-banner", Class: "bg-card text-warning *:data-[slot=alert-description]:text-warning"}) {
			@icon.TriangleAlert()
			@bannerBody(b)
		}
	}
}

templ bannerBody(b Banner) {
	@alert.Title() {
		{ b.Text }
	}
	if b.Href != "" {
		@alert.Description() {
			<a href={ templ.SafeURL(b.Href) } class="underline underline-offset-4">{ cmp.Or(b.LinkText, b.Href) }</a>
		}
	}
}

// SkipLink is hidden until focused, then jumps to #main. Shell renders it (its #main
// sits inside the sidebar inset, the page's one <main>); pages on Base with their
// own <main id="main" tabindex="-1"> can use it too.
templ SkipLink(lang string) {
	<a
		href="#main"
		class="sr-only rounded-lg bg-background px-3 py-2 text-body-sm font-medium text-foreground ring-2 ring-ring focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
	>
		{ labelsFor(lang).SkipToContent }
	</a>
}

// navMenu is one sidebar menu: each item with its icon, tooltip and active state,
// and its Children as an always-open sub-list.
templ navMenu(items []NavItem, active string) {
	@sidebar.Menu(sidebar.MenuProps{Class: "gap-1 group-data-[collapsible=icon]:items-center"}) {
		for _, it := range items {
			@sidebar.MenuItem() {
				@sidebar.MenuButton(sidebar.MenuButtonProps{Href: it.Href, IsActive: itemActive(it, active), Tooltip: it.Label}) {
					if it.Icon != nil {
						@it.Icon
					}
					<span>{ it.Label }</span>
				}
				if len(it.Children) > 0 {
					@sidebar.MenuSub() {
						for _, c := range it.Children {
							@sidebar.MenuSubItem() {
								@sidebar.MenuSubButton(sidebar.MenuSubButtonProps{Href: c.Href, IsActive: c.Href == active}) {
									<span>{ c.Label }</span>
								}
							}
						}
					}
				}
			}
		}
	}
}

package patterns

// ArionMark is the Arion star mark as inline SVG, filled with the brand-mark
// token: Arion blue on light surfaces, pure white in dark mode. It must be inline
// (not <img src="arion-mark.svg">) so its colour follows the .dark class rather
// than the OS setting. The geometry is assets/img/arion-mark.svg: a centre diamond
// and eight right triangles on a 45 degree grid. Never redraw or stretch it.
templ ArionMark(class string) {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="116 116 368 368" role="img" aria-label="Arion" class={ "text-brand-mark " + class }>
		<g fill="currentColor">
			<path d="M300 210 390 300 300 390 210 300Z"></path>
			<path d="M206 121V207H292Z"></path>
			<path d="M394 121V207H308Z"></path>
			<path d="M122 206H207V291Z"></path>
			<path d="M478 206H393V291Z"></path>
			<path d="M122 393H207V308Z"></path>
			<path d="M478 393H393V308Z"></path>
			<path d="M206 394H292L206 479Z"></path>
			<path d="M394 394H308L394 479Z"></path>
		</g>
	</svg>
}
